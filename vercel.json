{
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/blog/:slug",
      "destination": "/api/blog-post-page?slug=:slug"
    }
  ],
  "functions": {
    "api/blog-post-page.js": {
      "includeFiles": "{blog.html,404.html}"
    }
  },
  "redirects": [
    {
      "source": "/meetup",
      "destination": "/meetup.html#register",
      "permanent": false
    },
    {
      "source": "/register",
      "destination": "/meetup.html#register",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/assets/social/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ]
}
